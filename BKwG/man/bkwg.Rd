\name{bkwg}
\alias{bkwg}
\alias{dbkwg}
\alias{pbkwg}
\alias{qbkwg}
\alias{rbkwg}
\alias{sbkwg}
\alias{hbkwg}
\alias{chbkwg}
\title{The Beta Kumaraswamy-G Distribution}
\description{
Density, distribution function, quantile function, random generation,
survival, hazard and cumulative hazard functions of the beta
Kumaraswamy-G (BKw-G) distribution with an arbitrary baseline \eqn{G}.
}
\usage{
dbkwg(x, a = 1, b = 1, alpha = 1, beta = 1,
      baseline = "weibull", par = NULL, log = FALSE)
pbkwg(q, a = 1, b = 1, alpha = 1, beta = 1,
      baseline = "weibull", par = NULL, lower.tail = TRUE, log.p = FALSE)
qbkwg(p, a = 1, b = 1, alpha = 1, beta = 1,
      baseline = "weibull", par = NULL, lower.tail = TRUE, log.p = FALSE)
rbkwg(n, a = 1, b = 1, alpha = 1, beta = 1,
      baseline = "weibull", par = NULL)
sbkwg(x, a = 1, b = 1, alpha = 1, beta = 1,
      baseline = "weibull", par = NULL, log = FALSE)
hbkwg(x, a = 1, b = 1, alpha = 1, beta = 1,
      baseline = "weibull", par = NULL, log = FALSE)
chbkwg(x, a = 1, b = 1, alpha = 1, beta = 1,
       baseline = "weibull", par = NULL)
}
\arguments{
  \item{x, q}{vector of quantiles.}
  \item{p}{vector of probabilities.}
  \item{n}{number of observations. If \code{length(n) > 1}, the length is
    taken to be the number required.}
  \item{a, b}{positive Kumaraswamy shape parameters (scalars).}
  \item{alpha, beta}{positive beta-generator shape parameters (scalars);
    \eqn{m} and \eqn{n} in Handique et al. (2017).}
  \item{baseline}{the baseline distribution \eqn{G}: either the name of a
    built-in baseline (see \code{\link{bkwg_baselines}}) or an object created
    by \code{\link{bkwg_baseline}}.}
  \item{par}{baseline parameters: a named numeric vector or list (for
    example \code{c(shape = 2, scale = 1)} for \code{"weibull"}). Missing
    parameters take their default values; unnamed values are taken in the
    order given by \code{\link{bkwg_baselines}}.}
  \item{log, log.p}{logical; if \code{TRUE}, densities, probabilities and
    hazards are given on the log scale.}
  \item{lower.tail}{logical; if \code{TRUE} (default) probabilities are
    \eqn{P[X \le x]}{P[X <= x]}, otherwise \eqn{P[X > x]}.}
}
\details{
With \eqn{K(x) = 1 - [1 - G(x)^a]^b} (the Kumaraswamy-G cdf), the BKw-G
distribution has
\deqn{F(x) = I_{K(x)}(\alpha, \beta),}{F(x) = I_K(x)(alpha, beta),}
\deqn{f(x) = \frac{a b g(x) G(x)^{a-1} [1 - G(x)^a]^{b\beta - 1} K(x)^{\alpha-1}}{B(\alpha, \beta)},}{f(x) = a b g(x) G(x)^(a-1) [1 - G(x)^a]^(b beta - 1) K(x)^(alpha-1) / B(alpha, beta),}
and the closed-form quantile function
\deqn{Q(u) = G^{-1}\left( \left\{1 - [1 - z_u]^{1/b}\right\}^{1/a} \right),}{Q(u) = G^(-1)( {1 - [1 - z_u]^(1/b)}^(1/a) ),}
where \eqn{z_u} is the \eqn{u}-quantile of a Beta\eqn{(\alpha, \beta)}{(alpha, beta)}
distribution. All computations are carried out on the log scale so that
tails are accurate. Random numbers are generated by inversion of a beta
variate.

The survival function is \eqn{S(x) = 1 - F(x)}, the hazard is
\eqn{h(x) = f(x)/S(x)} and the cumulative hazard is \eqn{-\log S(x)}.
}
\value{
\code{dbkwg} gives the density, \code{pbkwg} the distribution function,
\code{qbkwg} the quantile function, \code{rbkwg} random deviates,
\code{sbkwg} the survival function, \code{hbkwg} the hazard function and
\code{chbkwg} the cumulative hazard function.
}
\references{
Handique, L., Chakraborty, S. and Ali, M. M. (2017). Beta generated
Kumaraswamy-G family of distributions. \emph{Pakistan Journal of Statistics},
\bold{33}(6), 467--490.
}
\seealso{
\code{\link{bkwg_baselines}}, \code{\link{fit_bkwg}},
\code{\link{score_bkwg}}, \code{\link{plot_bkwg}}.
}
\examples{
## BKw-Weibull
x <- seq(0.05, 3, by = 0.05)
d <- dbkwg(x, a = 2, b = 0.5, alpha = 1.5, beta = 2,
           baseline = "weibull", par = c(shape = 1.2, scale = 1))
integrate(dbkwg, 0, Inf, a = 2, b = 0.5, alpha = 1.5, beta = 2,
          par = c(shape = 1.2, scale = 1))

## quantile and cdf are inverse to each other
u <- c(0.1, 0.5, 0.9)
pbkwg(qbkwg(u, 2, 0.5, 1.5, 2, par = c(1.2, 1)), 2, 0.5, 1.5, 2,
      par = c(1.2, 1))

## all shape parameters equal to one gives the baseline
all.equal(dbkwg(x, par = c(shape = 2, scale = 3)),
          dweibull(x, shape = 2, scale = 3))

## other baselines
set.seed(1)
y <- rbkwg(5, a = 1.5, b = 2, alpha = 0.7, beta = 1.3, baseline = "norm",
           par = c(mean = 0, sd = 2))
hbkwg(1:3, 2, 1, 1, 1, baseline = "lomax", par = c(shape = 2, scale = 1))
}
\keyword{distribution}
