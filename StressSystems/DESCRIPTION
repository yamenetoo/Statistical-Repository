Package: StressSystems
Type: Package
Title: Stress-Strength Reliability of Single and Multicomponent Systems for
    Arbitrary Distributions
Version: 0.1.0
Authors@R: c(
    person("Mohamad Yamen", "AL Mohamad", email = "yamenmohamad@tabrizu.ac.ir",
           role = c("aut", "cre"), comment = c(ORCID = "0000-0003-4658-9095")),
    person("Ali Akbar", "Heydari", email = "heydari@tabrizu.ac.ir",
           role = "aut", comment = c(ORCID = "0000-0002-1236-3189")),
